# ============================================================
# VARIÁVEIS DE AMBIENTE — Black November Villa di Napoli
# Copie este arquivo para ".env.local" (uso no seu computador)
# ou cadastre cada linha no painel da hospedagem (Vercel/Railway).
# ============================================================

# --- OBRIGATÓRIAS ---

# Conexão com o banco de dados PostgreSQL.
# Supabase: botão "Connect" > "Transaction pooler" (porta 6543).
DATABASE_URL=

# Senha do painel /admin (mínimo 8 caracteres; use uma senha forte).
ADMIN_PASSWORD=

# Endereço público do site, sem barra no final.
NEXT_PUBLIC_SITE_URL=https://seu-dominio.com.br

# --- RECOMENDADA ---

# Texto aleatório longo, usado para proteger a sessão do painel.
ADMIN_SESSION_SECRET=

# --- MEDIÇÃO (opcionais; deixe vazio o que não usar) ---
# Use GTM *ou* GA4 + Pixel diretos, para não contar eventos em dobro.
NEXT_PUBLIC_GTM_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_META_PIXEL_ID=

# "true" (padrão): só carrega as ferramentas de medição depois que o
# visitante aceita os cookies. "false": carrega sempre.
NEXT_PUBLIC_REQUIRE_COOKIE_CONSENT=true

# Só para banco local sem SSL: DATABASE_SSL=disable
